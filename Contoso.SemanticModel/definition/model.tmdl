model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","TMDL-Extension"]

ref table Customer
ref table Product
ref table Date
ref table Orders
ref table 'Order Rows'
ref table 'Currency Exchange'

ref cultureInfo en-US

