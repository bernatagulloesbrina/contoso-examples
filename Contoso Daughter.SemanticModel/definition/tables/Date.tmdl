		sortByColumn: 'Day of Week Number'

		annotation SummarizationSetBy = Automatic

	column 'Day of Week Number'
		dataType: int64
		formatString: 0
		lineageTag: c0000003-0000-4000-8000-000000000010
		summarizeBy: none
		sourceColumn: DayofWeekNumber

		annotation SummarizationSetBy = Automatic

	column 'Day of Week Short'
