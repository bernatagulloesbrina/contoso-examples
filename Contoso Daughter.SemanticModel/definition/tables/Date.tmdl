		summarizeBy: none
		sourceColumn: MonthShort
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: c0000003-0000-4000-8000-000000000007
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	column 'Working Day'
		dataType: int64
		formatString: 0
		lineageTag: c0000003-0000-4000-8000-000000000011
