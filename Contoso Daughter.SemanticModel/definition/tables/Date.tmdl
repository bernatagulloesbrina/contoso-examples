/// Gregorian calendar dimension. Marked as a Date table (dataCategory: Time)
/// for classic time intelligence (SAMEPERIODLASTYEAR, etc.) AND carries a
/// Gregorian calendar child object for the new calendar-based time intel
/// functions (requires compatibilityLevel >= 1701).
table Date
	lineageTag: c0000003-0000-4000-8000-000000000001
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: General Date
		lineageTag: c0000003-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column 'Date Key'
		dataType: string
		lineageTag: c0000003-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	column 'Day of Week'
		dataType: string
		lineageTag: c0000003-0000-4000-8000-00000000000e
		summarizeBy: none
