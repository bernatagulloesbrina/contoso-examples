	column Year
		dataType: int64
		formatString: 0
		lineageTag: c0000003-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		dataType: string
		lineageTag: c0000003-0000-4000-8000-000000000008
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: 'Year Month Number'

		annotation SummarizationSetBy = Automatic

	column 'Year Month Number'
		dataType: int64
		formatString: 0
		lineageTag: c0000003-0000-4000-8000-00000000000a
