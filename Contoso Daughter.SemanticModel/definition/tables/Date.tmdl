	partition Date = entity
		mode: directLake
		source
			entityName: date
			schemaName: dbo
			expressionSource: 'DirectLake - Contoso'

	calendar Gregorian
		lineageTag: c0000003-0000-4000-8000-0000000000c0

		calendarColumnGroup = year
			primaryColumn: Year

		calendarColumnGroup = quarter
			primaryColumn: 'Year Quarter Number'
			associatedColumn: 'Year Quarter'

		calendarColumnGroup = quarterOfYear
